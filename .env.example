# Copy to .env and fill in. .env is git-ignored - never commit real keys.

# Transport for NSW Open Data Hub API key (free): https://opendata.transport.nsw.gov.au
# The same key also powers the live public transport layer (trains, buses, ferries, light rail).
# Leave blank to run both on bundled sample data.
TFNSW_API_KEY=

# OpenSky Network API client (free): https://opensky-network.org -> Account -> API client
# Used by the flights layer (milestone 2).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# aisstream.io API key (free, sign in with GitHub): https://aisstream.io
# Used by the ships layer. Leave blank to run ships on sample data.
AISSTREAM_API_KEY=

# Production only: include the Caddy/HTTPS overlay in every `docker compose` command
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# Production only (docker-compose.prod.yml): the public domain Caddy serves, e.g. ozwatch.example.com
# DOMAIN=
# Free DuckDNS name (deploy/duckdns-update.sh keeps it pointed at the server):
# DUCKDNS_SUBDOMAIN=
# DUCKDNS_TOKEN=

# Database password used by docker-compose (change it for any public deployment).
POSTGRES_PASSWORD=ozwatch

# Optional overrides
# POLL_CAMERAS=600
# HISTORY_HOURS=24
# LOG_LEVEL=INFO

# Only needed when running the backend outside Docker (blank = in-memory store):
# DATABASE_URL=postgresql://ozwatch:ozwatch@localhost:5432/ozwatch
